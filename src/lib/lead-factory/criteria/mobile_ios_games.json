  "genre_exclude": ["Casino", "Card", "Board", "Word", "Trivia", "Educational", "Puzzle", "Dice", "Kids"],
  "contact_rules": {
    "email_required": false,
    "note": "Scrape sellerUrl for email. Generic emails are kept but scored lower."
  }
