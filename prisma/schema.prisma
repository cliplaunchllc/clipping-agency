generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agency
  clipper
  client
}

enum Platform {
  tiktok
  instagram
  youtube
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clipper       Clipper?
  clientAccount ClientAccount?
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Clipper {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  user        User                     @relation(fields: [userId], references: [id])
  assignments ClipperClientAssignment[]
  subAccounts SubAccount[]
  submissions Submission[]
}

model ClientAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  logo        String?
  status      String   @default("active")
  packageInfo String?
  notes       String?
  createdAt   DateTime @default(now())

  user        User                     @relation(fields: [userId], references: [id])
  assignments ClipperClientAssignment[]
  subAccounts SubAccount[]
  onboarding  OnboardingStep[]
}

model ClipperClientAssignment {
  id        String   @id @default(cuid())
  clipperId String
  clientId  String
  createdAt DateTime @default(now())

  clipper Clipper       @relation(fields: [clipperId], references: [id])
  client  ClientAccount @relation(fields: [clientId], references: [id])

  @@unique([clipperId, clientId])
}

model SubAccount {
  id          String   @id @default(cuid())
  clientId    String
  clipperId   String
  platform    Platform
  handle      String
  profileUrl  String
  createdAt   DateTime @default(now())

  client      ClientAccount @relation(fields: [clientId], references: [id])
  clipper     Clipper       @relation(fields: [clipperId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  subAccountId String
  clipperId    String
  clipUrl      String
  platform     Platform
  submittedAt  DateTime @default(now())
  lastScraped  DateTime?
  scrapeStatus String   @default("pending")

  subAccount SubAccount       @relation(fields: [subAccountId], references: [id])
  clipper    Clipper          @relation(fields: [clipperId], references: [id])
  snapshots  MetricSnapshot[]
}

model MetricSnapshot {
  id           String   @id @default(cuid())
  submissionId String
  timestamp    DateTime @default(now())
  views        BigInt   @default(0)
  likes        BigInt   @default(0)
  comments     BigInt   @default(0)
  shares       BigInt   @default(0)
  saves        BigInt   @default(0)

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId, timestamp])
}

model OnboardingStep {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  completed Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())

  client ClientAccount @relation(fields: [clientId], references: [id])
}
