generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agency
  clipper
  client
}

enum Platform {
  tiktok
  instagram
  youtube
  twitter
  other
}

enum UserStatus {
  pending
  active
}

enum ClientStatus {
  active
  archived
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         Role
  clientId     String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  client         Client?        @relation(fields: [clientId], references: [id])
  clipperProfile ClipperProfile?
  sessions       Session[]
  accounts       Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  status         ClientStatus @default(active)
  logoUrl        String?
  dealLengthDays Int?
  pageCount      Int?
  clipsPerDay    Int?
  archivedAt     DateTime?
  shareToken     String?      @unique
  createdAt      DateTime     @default(now())

  users           User[]
  clips           Clip[]
  links           ClientLink[]
  onboardingSteps ClientOnboardingStep[]
}

model ClientLink {
  id        String   @id @default(cuid())
  clientId  String
  label     String
  url       String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientOnboardingStep {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String?
  linkUrl     String?
  order       Int      @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  key   String @id
  value String @db.Text
}

model ClipperProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id])
  subAccounts ClipperSubAccount[]
  clips       Clip[]
}

model ClipperSubAccount {
  id         String   @id @default(cuid())
  clipperId  String
  platform   Platform
  handle     String
  profileUrl String?
  createdAt  DateTime @default(now())

  clipper ClipperProfile @relation(fields: [clipperId], references: [id])
  clips   Clip[]
}

model Clip {
  id           String    @id @default(cuid())
  clipperId    String
  clientId     String
  subAccountId String
  url          String
  title        String?
  thumbnailUrl String?
  views        BigInt    @default(0)
  likes        BigInt    @default(0)
  comments     BigInt    @default(0)
  shares       BigInt    @default(0)
  saves        BigInt    @default(0)
  earnings     Float     @default(0)
  submittedAt  DateTime  @default(now())
  lastScraped  DateTime?

  clipper    ClipperProfile    @relation(fields: [clipperId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  subAccount ClipperSubAccount @relation(fields: [subAccountId], references: [id])
}
