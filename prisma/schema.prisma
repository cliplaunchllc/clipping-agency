generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agency
  clipper
  client
}

enum Platform {
  tiktok
  instagram
  youtube
  twitter
  other
}

enum UserStatus {
  pending
  active
}

enum ClientStatus {
  active
  justlaunched
  prelaunch
  archived
}

enum OngoingStatus {
  Strong
  Normal
  NeedsAttention
}

enum CampaignType {
  manual
  cpm
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String?
  passwordHash      String
  role              Role
  clientId          String?
  status            UserStatus @default(active)
  mustChangePassword Boolean   @default(false)
  isTeamMember      Boolean   @default(false)
  teamRole          String?   // head_campaign | campaign_manager | va | discord_mod | freelance
  createdAt         DateTime   @default(now())

  client         Client?        @relation(fields: [clientId], references: [id])
  clipperProfile ClipperProfile?
  sessions       Session[]
  accounts       Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  status         ClientStatus @default(active)
  logoUrl        String?
  bannerUrl      String?
  dealLengthDays Int?
  dealStartDate  DateTime?
  dealEndDate    DateTime?
  pageCount      Int?
  clipsPerDay    Int?
  archivedAt     DateTime?
  shareToken     String?      @unique
  campaignType        CampaignType @default(manual)
  campaignTrackerUrl  String?
  welcomePageUrl      String?
  welcomeVideoUrl     String?
  intakeFormUrl       String?
  contractUrl         String?
  lastContactedAt     DateTime?
  createdAt           DateTime     @default(now())

  users            User[]
  clips            Clip[]
  links            ClientLink[]
  onboardingSteps  ClientOnboardingStep[]
  campaigns        ClientCampaign[]
  campaignReports  CampaignReport[]
  ongoingReports   OngoingReport[]
}

model ClientLink {
  id        String   @id @default(cuid())
  clientId  String
  label     String
  url       String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientCampaign {
  id          String    @id @default(cuid())
  clientId    String
  name        String
  totalBudget Float     @default(0)
  order       Int       @default(1)
  createdAt   DateTime  @default(now())

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignReports CampaignReport[]
  ongoingReports  OngoingReport[]
}

model ClientOnboardingStep {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String?
  linkUrl     String?
  order       Int      @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  key   String @id
  value String @db.Text
}

model ClipperProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id])
  subAccounts ClipperSubAccount[]
  clips       Clip[]
}

model ClipperSubAccount {
  id         String   @id @default(cuid())
  clipperId  String
  platform   Platform
  handle     String
  profileUrl String?
  createdAt  DateTime @default(now())

  clipper ClipperProfile @relation(fields: [clipperId], references: [id])
  clips   Clip[]
}

model CampaignReport {
  id              String    @id @default(cuid())
  clientId        String
  weekStartDate   DateTime
  weekEndDate     DateTime
  totalViews      Int       @default(0)
  tiktokViews     Int       @default(0)
  instagramViews  Int       @default(0)
  youtubeViews    Int       @default(0)
  twitterViews    Int       @default(0)
  paidOut         Float     @default(0)
  effectiveCpm    Float?
  budgetRemaining Float?
  clipsSubmitted  Int       @default(0)
  clipsApproved   Int       @default(0)
  cumViews        Int       @default(0)
  cumTiktokViews  Int       @default(0)
  cumInstagramViews Int     @default(0)
  cumYoutubeViews Int       @default(0)
  cumTwitterViews Int       @default(0)
  cumPaidOut      Float     @default(0)
  cumClipsSubmitted Int     @default(0)
  cumClipsApproved  Int     @default(0)
  cumEffectiveCpm   Float?
  weeklySummary   String?
  whatsWorking    String?
  whatsNotWorking String?
  nextWeekFocus   String?
  campaignLink    String?
  campaignId      String?
  amountSpent     Float?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign ClientCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model OngoingReport {
  id               String        @id @default(cuid())
  clientId         String
  date             DateTime
  campaignName     String        @default("")
  totalSubmissions Int           @default(0)
  pending          Int           @default(0)
  approved         Int           @default(0)
  rejected         Int           @default(0)
  mainTrend        String?
  clipperFeedback  String?
  mainOptimization String?
  status           OngoingStatus @default(Normal)
  viewsTotal       Int           @default(0)
  viewsToday       Int           @default(0)
  campaignId       String?
  amountSpent      Float?
  effectiveCpm     Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign ClientCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model CrmLead {
  id                String    @id @default(cuid())
  leadName          String
  instagram         String?
  email             String?
  linkedin          String?
  x                 String?

  outreachedIg      Boolean   @default(false)
  outreachedEmail   Boolean   @default(false)
  outreachedLinkedin Boolean  @default(false)
  outreachedX       Boolean   @default(false)

  dateMessaged      DateTime?
  followUp1         DateTime?
  followUp2         DateTime?
  followUp3         DateTime?

  replied           Boolean   @default(false)
  replyMessage      String?

  callBooked        Boolean   @default(false)
  showedUpToCall    Boolean   @default(false)
  closedCall        Boolean   @default(false)

  whoMessaged       String?

  notes             String?
  leadSource        String?   @default("cold_outbound")

  inConvo           Boolean   @default(false)
  leadLost          Boolean   @default(false)
  markedDone        Boolean   @default(false)
  lastFollowUpDate  DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Clip {
  id           String    @id @default(cuid())
  clipperId    String
  clientId     String
  subAccountId String
  url          String
  title        String?
  thumbnailUrl String?
  views        BigInt    @default(0)
  likes        BigInt    @default(0)
  comments     BigInt    @default(0)
  shares       BigInt    @default(0)
  saves        BigInt    @default(0)
  earnings     Float     @default(0)
  submittedAt  DateTime  @default(now())
  lastScraped  DateTime?

  clipper    ClipperProfile    @relation(fields: [clipperId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  subAccount ClipperSubAccount @relation(fields: [subAccountId], references: [id])
}

model Sop {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamPaymentMember {
  id             String    @id @default(cuid())
  name           String
  role           String?
  category       String
  payRate        Float?
  payFrequency   String?
  lastPaidAt     DateTime?
  nextPaymentDue DateTime?
  notes          String?
  basePay        Float?    // base salary for head_campaign (added to commission total)
  commissions    Json?     // [{ id, campaignName, budget, commission }] for head_campaign
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Lead Factory ────────────────────────────────────────────────────────────

model LeadRun {
  id         String   @id @default(cuid())
  prompt     String   @db.Text
  offer      String?  @db.Text
  criteria   String?  @db.Text
  count      Int      @default(25)
  mode       String   @default("deep")      // deep|bulk
  status     String   @default("pending")   // pending|planning|discovering|researching|verifying|scoring|building|completed|stopped|failed
  stage      String?
  plan       Json?
  totalCost  Float    @default(0)
  testMode   Boolean  @default(false)
  stats      Json?
  mdFile     String?  @db.Text
  htmlFile   String?  @db.Text
  csvFile    String?  @db.Text
  jsonFile   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads LeadFactoryLead[]
  logs  LeadRunLog[]
  costs LeadRunCost[]
}

model LeadFactoryLead {
  id              String   @id @default(cuid())
  runId           String
  num             Int      @default(0)
  grade           String?
  score           Int?
  segment         String?
  country         String?
  company         String
  website         String
  whatItIs        String?  @db.Text
  sisterBrands    Json?
  decisionMaker   String?
  dmRole          String?
  dmRoleCheck     String?
  bestChannel     String?
  xHandle         String?
  xCheck          String?
  instagramHandle String?
  instagramCheck  String?
  linkedinUrl     String?
  linkedinCheck   String?
  dmEmail         String?
  dmEmailCheck    String?
  companyAccounts Json?
  whyItFits       Json?
  otherPeople     Json?
  signals         Json?
  sources         Json?
  checkedAt       String?
  status          String   @default("active")  // active|deleted|do_not_contact
  rawData         Json?
  createdAt       DateTime @default(now())

  run LeadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model LeadRunLog {
  id        String   @id @default(cuid())
  runId     String
  stage     String
  message   String   @db.Text
  level     String   @default("info")  // info|warn|error|debug
  createdAt DateTime @default(now())

  run LeadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model LeadRunCost {
  id        String   @id @default(cuid())
  runId     String
  provider  String
  operation String
  units     Float    @default(0)
  cost      Float    @default(0)
  createdAt DateTime @default(now())

  run LeadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}
